@page
@model DailyExpenseTracker.Web.Pages.Expenses.IndexModel
@{
    ViewData["Title"] = "Expenses";
}

<!-- Content Header -->
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold">Expenses</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end mb-0">
                    <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Expenses</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="app-content">
    <div class="container-fluid">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card card-primary card-outline shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="card-title fw-bold mb-0">
                    <i class="bi bi-receipt me-2 text-primary"></i>All Recorded Expenses
                </h5>
                <div class="card-tools ms-auto">
                    <a asp-page="/Expenses/Create" class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Entry Expense
                    </a>
                </div>
            </div>

            <div class="card-body p-0">
                @if (Model.Expenses.Count == 0)
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                        <p class="fs-5 mb-2">No expenses recorded yet.</p>
                        <a asp-page="/Expenses/Create" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-plus-circle me-1"></i> Record your first expense
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light border-bottom">
                                <tr>
                                    <th scope="col" class="ps-4">Date</th>
                                    <th scope="col">Category</th>
                                    <th scope="col">Payment Method</th>
                                    <th scope="col">Description</th>
                                    <th scope="col" class="text-end">Amount</th>
                                    <th scope="col" class="text-center pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var expense in Model.Expenses)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-nowrap">
                                            <i class="bi bi-calendar3 me-1 text-muted"></i>
                                            @expense.ExpenseDate.ToString("yyyy-MM-dd")
                                        </td>
                                        <td>
                                            <span class="badge text-bg-secondary fw-normal px-2 py-1">
                                                <i class="bi bi-tag-fill me-1"></i>@expense.CategoryName
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge text-bg-light border text-dark fw-normal">
                                                @expense.PaymentMethod
                                            </span>
                                        </td>
                                        <td class="text-truncate" style="max-width: 250px;">
                                            @(string.IsNullOrWhiteSpace(expense.Description) ? "—" : expense.Description)
                                        </td>
                                        <td class="text-end fw-bold text-nowrap">
                                            ৳ @expense.Amount.ToString("N2")
                                        </td>
                                        <td class="text-center pe-4 text-nowrap">
                                            <a asp-page="/Expenses/Edit" asp-route-id="@expense.Id" class="btn btn-warning btn-sm fw-semibold shadow-sm">
                                                <i class="bi bi-pencil-square me-1"></i> Edit
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (Model.Expenses.Count > 0)
            {
                <div class="card-footer text-muted small py-2 px-4 d-flex justify-content-between align-items-center">
                    <span>Showing <b>@Model.Expenses.Count</b> expense(s)</span>
                    <span class="text-secondary">Currency: BDT (৳)</span>
                </div>
            }
        </div>
    </div>
</div>
