@page
@model DailyExpenseTracker.Web.Pages.Expenses.IndexModel
@{
    ViewData["Title"] = "Expenses";
}

<!-- Content Header -->
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold">Expenses</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end mb-0">
                    <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Expenses</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="app-content">
    <div class="container-fluid">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill fs-5 me-2"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                    <div>@TempData["ErrorMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card card-primary card-outline shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="card-title fw-bold mb-0">
                    <i class="bi bi-receipt me-2 text-primary"></i>All Recorded Expenses
                </h5>
                <div class="card-tools ms-auto">
                    <a asp-page="/Expenses/Create" class="btn btn-primary btn-sm px-3 shadow-sm fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i> Entry Expense
                    </a>
                </div>
            </div>

            <div class="card-body p-0">
                <form method="get" class="row g-2 align-items-end p-3 border-bottom bg-light">
                    <div class="col-12 col-md-3">
                        <label asp-for="FromDate" class="form-label small fw-semibold">From</label>
                        <input asp-for="FromDate" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label asp-for="ToDate" class="form-label small fw-semibold">To</label>
                        <input asp-for="ToDate" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label asp-for="CategoryId" class="form-label small fw-semibold">Category</label>
                        <select asp-for="CategoryId" class="form-select form-select-sm">
                            <option value="">All categories</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="bi bi-funnel me-1"></i>Filter</button>
                        <a asp-page="/Expenses/Index" class="btn btn-outline-secondary btn-sm">Clear</a>
                    </div>
                    <div class="col-12"><span asp-validation-for="FromDate" class="text-danger small"></span><span asp-validation-for="ToDate" class="text-danger small"></span><span asp-validation-summary="ModelOnly" class="text-danger small"></span></div>
                </form>
                @if (Model.Expenses.Count == 0)
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                        <p class="fs-5 mb-2">No expenses recorded yet.</p>
                        <a asp-page="/Expenses/Create" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-plus-circle me-1"></i> Record your first expense
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light border-bottom">
                                <tr>
                                    <th scope="col" class="ps-4">Date</th>
                                    <th scope="col">Category</th>
                                    <th scope="col">Payment Method</th>
                                    <th scope="col">Description</th>
                                    <th scope="col" class="text-end">Amount</th>
                                    <th scope="col" class="text-center pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var expense in Model.Expenses)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-nowrap">
                                            <i class="bi bi-calendar3 me-1 text-muted"></i>
                                            @expense.ExpenseDate.ToString("yyyy-MM-dd")
                                        </td>
                                        <td>
                                            <span class="badge @Model.GetCategoryBadgeClass(expense.CategoryName) fw-semibold px-2 py-1">
                                                <i class="bi bi-tag-fill me-1"></i>@expense.CategoryName
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge text-bg-light border text-dark fw-normal">
                                                @expense.PaymentMethod
                                            </span>
                                        </td>
                                        <td class="text-truncate" style="max-width: 250px;" title="@expense.Description">
                                            @if (string.IsNullOrWhiteSpace(expense.Description))
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                <i class="bi @Model.GetDescriptionIconClass(expense.Description, expense.CategoryName) me-1" aria-hidden="true"></i>@expense.Description
                                            }
                                        </td>
                                        <td class="text-end fw-bold text-nowrap">
                                            ৳ @expense.Amount.ToString("N2")
                                        </td>
                                        <td class="text-center pe-4 text-nowrap">
                                            <div class="d-inline-flex gap-1">
                                                <a asp-page="/Expenses/Edit" asp-route-id="@expense.Id" class="btn btn-warning btn-sm fw-semibold shadow-sm">
                                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                                </a>
                                                <button type="button"
                                                        class="btn btn-danger btn-sm fw-semibold shadow-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteExpenseModal"
                                                        data-expense-id="@expense.Id"
                                                        data-expense-date="@expense.ExpenseDate.ToString("yyyy-MM-dd")"
                                                        data-expense-category="@expense.CategoryName"
                                                        data-expense-amount="৳ @expense.Amount.ToString("N2")">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (Model.TotalExpenses > 0)
            {
                <div class="card-footer py-2 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="text-muted small">
                        Showing <b>@Model.FirstExpenseNumber-@Model.LastExpenseNumber</b>
                        of <b>@Model.TotalExpenses</b> expenses
                    </span>
                    <nav aria-label="Expense pages">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="/Expenses/Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-categoryId="@Model.CategoryId" aria-label="Previous page">&laquo;</a>
                            </li>
                            @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
                            {
                                <li class="page-item @(pageIndex == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-page="/Expenses/Index" asp-route-pageNumber="@pageIndex" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-categoryId="@Model.CategoryId" aria-current="@(pageIndex == Model.PageNumber ? "page" : null)">@pageIndex</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="/Expenses/Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-categoryId="@Model.CategoryId" aria-label="Next page">&raquo;</a>
                            </li>
                        </ul>
                    </nav>
                    <span class="text-secondary small">Currency: BDT (৳)</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteExpenseModal" tabindex="-1" aria-labelledby="deleteExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="deleteExpenseModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page="/Expenses/Delete">
                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteExpenseId" value="" />
                    <p class="mb-3">Are you sure you want to delete this expense? This action cannot be undone.</p>
                    <ul class="list-group list-group-flush small border rounded">
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Date</span>
                            <span class="fw-semibold" id="deleteExpenseDate"></span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Category</span>
                            <span class="fw-semibold" id="deleteExpenseCategory"></span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="text-muted">Amount</span>
                            <span class="fw-bold text-danger" id="deleteExpenseAmount"></span>
                        </li>
                    </ul>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="bi bi-trash me-1"></i> Delete Expense
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modalEl = document.getElementById('deleteExpenseModal');
            if (!modalEl) return;

            modalEl.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                if (!button) return;

                document.getElementById('deleteExpenseId').value = button.getAttribute('data-expense-id') || '';
                document.getElementById('deleteExpenseDate').textContent = button.getAttribute('data-expense-date') || '';
                document.getElementById('deleteExpenseCategory').textContent = button.getAttribute('data-expense-category') || '';
                document.getElementById('deleteExpenseAmount').textContent = button.getAttribute('data-expense-amount') || '';
            });
        })();
    </script>
}
