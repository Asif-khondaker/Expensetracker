@page "{id:int}"
@model DailyExpenseTracker.Web.Pages.Expenses.EditModel
@{
    ViewData["Title"] = $"Edit Expense #{Model.Input.Id}";
}

<!-- Content Header -->
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold">Edit Expense #@Model.Input.Id</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end mb-0">
                    <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-page="/Expenses/Index">Expenses</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit #@Model.Input.Id</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="app-content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">

                <div class="card card-warning card-outline shadow-sm mb-4">
                    <div class="card-header">
                        <h5 class="card-title fw-bold mb-0">
                            <i class="bi bi-pencil-square me-2 text-warning"></i>Update Expense Details
                        </h5>
                    </div>

                    <form method="post" novalidate>
                        <input type="hidden" asp-for="Input.Id" />

                        <div class="card-body p-4">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                            <!-- Expense Date -->
                            <div class="mb-3">
                                <label asp-for="Input.ExpenseDate" class="form-label fw-bold">
                                    <i class="bi bi-calendar-event me-1 text-primary"></i> Expense Date <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.ExpenseDate" class="form-control" type="date" required />
                                <span asp-validation-for="Input.ExpenseDate" class="text-danger small"></span>
                            </div>

                            <!-- Amount -->
                            <div class="mb-3">
                                <label asp-for="Input.Amount" class="form-label fw-bold">
                                    <i class="bi bi-cash me-1 text-success"></i> Amount (BDT) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text fw-bold bg-light">৳</span>
                                    <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" min="0.01" max="10000000" placeholder="0.00" required />
                                </div>
                                <span asp-validation-for="Input.Amount" class="text-danger small"></span>
                                <div class="form-text">Amount in Bangladeshi Taka (max 10,000,000).</div>
                            </div>

                            <!-- Category -->
                            <div class="mb-3">
                                <label asp-for="Input.CategoryId" class="form-label fw-bold">
                                    <i class="bi bi-tags me-1 text-info"></i> Category <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.CategoryId" class="form-select" required>
                                    <option value="">-- Select a Category --</option>
                                    @foreach (var cat in Model.CategoryOptions)
                                    {
                                        <option value="@cat.Value">@cat.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                            </div>

                            <!-- Payment Method -->
                            <div class="mb-3">
                                <label asp-for="Input.PaymentMethod" class="form-label fw-bold">
                                    <i class="bi bi-credit-card me-1 text-secondary"></i> Payment Method <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Input.PaymentMethod" class="form-select" asp-items="Model.PaymentMethodOptions" required>
                                </select>
                                <span asp-validation-for="Input.PaymentMethod" class="text-danger small"></span>
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <label asp-for="Input.Description" class="form-label fw-bold">
                                    <i class="bi bi-chat-left-text me-1 text-muted"></i> Description
                                </label>
                                <textarea asp-for="Input.Description" class="form-control" rows="3" maxlength="500" placeholder="Optional details (max 500 characters)"></textarea>
                                <span asp-validation-for="Input.Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="card-footer bg-light d-flex justify-content-between align-items-center py-3 px-4">
                            <a asp-page="/Expenses/Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
