@page "{id:int}"
@model DailyExpenseTracker.Web.Pages.Expenses.EditModel
@{
    ViewData["Title"] = $"Edit Expense #{Model.Input.Id}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0 fw-semibold">
                        <i class="bi bi-pencil-square me-2"></i>Edit Expense #@Model.Input.Id
                    </h4>
                    <p class="small text-muted mb-0">Update details for this recorded expense</p>
                </div>

                <div class="card-body p-4">
                    <form method="post" novalidate>
                        <input type="hidden" asp-for="Input.Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Expense Date -->
                        <div class="mb-3">
                            <label asp-for="Input.ExpenseDate" class="form-label fw-bold">Expense Date <span class="text-danger">*</span></label>
                            <input asp-for="Input.ExpenseDate" class="form-control" type="date" required />
                            <span asp-validation-for="Input.ExpenseDate" class="text-danger small"></span>
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label asp-for="Input.Amount" class="form-label fw-bold">Amount (BDT) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text fw-bold">৳</span>
                                <input asp-for="Input.Amount" class="form-control" type="number" step="0.01" min="0.01" max="10000000" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="Input.Amount" class="text-danger small"></span>
                            <div class="form-text">Amount in Bangladeshi Taka (max 10,000,000).</div>
                        </div>

                        <!-- Category -->
                        <div class="mb-3">
                            <label asp-for="Input.CategoryId" class="form-label fw-bold">Category <span class="text-danger">*</span></label>
                            <select asp-for="Input.CategoryId" class="form-select" required>
                                <option value="">-- Select a Category --</option>
                                @foreach (var cat in Model.CategoryOptions)
                                {
                                    <option value="@cat.Value">@cat.Text</option>
                                }
                            </select>
                            <span asp-validation-for="Input.CategoryId" class="text-danger small"></span>
                        </div>

                        <!-- Payment Method -->
                        <div class="mb-3">
                            <label asp-for="Input.PaymentMethod" class="form-label fw-bold">Payment Method <span class="text-danger">*</span></label>
                            <select asp-for="Input.PaymentMethod" class="form-select" asp-items="Model.PaymentMethodOptions" required>
                            </select>
                            <span asp-validation-for="Input.PaymentMethod" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Input.Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Input.Description" class="form-control" rows="3" maxlength="500" placeholder="Optional details (max 500 characters)"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger small"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-page="/Expenses/Index" class="btn btn-outline-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-warning px-4 fw-semibold">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
