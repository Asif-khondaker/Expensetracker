@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Content Header -->
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h3 class="mb-0 fw-bold">Dashboard</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end mb-0">
                    <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- Main Content -->
<div class="app-content">
    <div class="container-fluid">
        @if (!string.IsNullOrWhiteSpace(Model.FilterError))
        {
            <div class="alert alert-danger" role="alert">@Model.FilterError The current month is shown.</div>
        }
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <div class="text-muted small text-uppercase fw-semibold">Today's expense</div>
                    <div class="fs-3 fw-bold text-primary">৳ @Model.Summary.TodayTotal.ToString("N2")</div>
                    <div class="small text-muted">@DateTime.Today.ToString("MMMM d, yyyy")</div>
                </div></div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <div class="text-muted small text-uppercase fw-semibold">This month</div>
                    <div class="fs-3 fw-bold text-success">৳ @Model.Summary.MonthTotal.ToString("N2")</div>
                    <div class="small text-muted">@DateTime.Today.ToString("MMMM yyyy")</div>
                </div></div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <div class="text-muted small text-uppercase fw-semibold">Selected period</div>
                    <div class="fs-3 fw-bold text-info">৳ @Model.Summary.SelectedPeriodTotal.ToString("N2")</div>
                    <div class="small text-muted">@Model.Summary.FromDate.ToString("yyyy-MM-dd") – @Model.Summary.ToDate.ToString("yyyy-MM-dd")</div>
                </div></div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-12 col-sm-4"><label asp-for="FromDate" class="form-label">Period from</label><input asp-for="FromDate" type="date" class="form-control" /></div>
                    <div class="col-12 col-sm-4"><label asp-for="ToDate" class="form-label">Period to</label><input asp-for="ToDate" type="date" class="form-control" /></div>
                    <div class="col-12 col-sm-4 d-flex gap-2"><button class="btn btn-primary" type="submit"><i class="bi bi-calendar-range me-1"></i>Update summary</button><a asp-page="/Index" class="btn btn-outline-secondary">This month</a></div>
                </form>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm h-100">
                    <div class="card-header fw-bold"><i class="bi bi-pie-chart me-2 text-primary"></i>Category totals</div>
                    <div class="card-body p-0">
                        @if (Model.Summary.CategoryTotals.Count == 0)
                        { <p class="text-muted text-center p-4 mb-0">No expenses in this period.</p> }
                        else
                        {
                            <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th class="ps-3">Category</th><th class="text-end pe-3">Total</th></tr></thead><tbody>
                            @foreach (var item in Model.Summary.CategoryTotals)
                            { <tr><td class="ps-3">@item.CategoryName</td><td class="text-end pe-3 fw-semibold">৳ @item.Total.ToString("N2")</td></tr> }
                            </tbody></table></div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-7">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center"><span class="fw-bold"><i class="bi bi-clock-history me-2 text-primary"></i>Recent expenses</span><a asp-page="/Expenses/Index" class="btn btn-sm btn-outline-primary">All expenses</a></div>
                    <div class="card-body p-0">
                        @if (Model.Summary.RecentExpenses.Count == 0)
                        { <p class="text-muted text-center p-4 mb-0">No expenses in this period.</p> }
                        else
                        {
                            <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0"><thead><tr><th class="ps-3">Date</th><th>Category</th><th>Description</th><th class="text-end pe-3">Amount</th></tr></thead><tbody>
                            @foreach (var expense in Model.Summary.RecentExpenses)
                            { <tr><td class="ps-3 text-nowrap">@expense.ExpenseDate.ToString("yyyy-MM-dd")</td><td>@expense.CategoryName</td><td class="text-truncate" style="max-width:180px">@(string.IsNullOrWhiteSpace(expense.Description) ? "—" : expense.Description)</td><td class="text-end pe-3 fw-semibold text-nowrap">৳ @expense.Amount.ToString("N2")</td></tr> }
                            </tbody></table></div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats / Action Boxes -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-md-4">
                <div class="info-box shadow-sm">
                    <span class="info-box-icon text-bg-primary shadow-sm">
                        <i class="bi bi-plus-circle-fill"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Quick Entry</span>
                        <span class="info-box-number">Record Expense</span>
                        <a asp-page="/Expenses/Create" class="btn btn-outline-primary btn-sm mt-1">
                            Add New &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-4">
                <div class="info-box shadow-sm">
                    <span class="info-box-icon text-bg-success shadow-sm">
                        <i class="bi bi-receipt"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Records</span>
                        <span class="info-box-number">View &amp; Edit</span>
                        <a asp-page="/Expenses/Index" class="btn btn-outline-success btn-sm mt-1">
                            View All &rarr;
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-md-4">
                <div class="info-box shadow-sm">
                    <span class="info-box-icon text-bg-warning shadow-sm">
                        <i class="bi bi-currency-exchange"></i>
                    </span>
                    <div class="info-box-content">
                        <span class="info-box-text">Currency</span>
                        <span class="info-box-number">BDT (৳)</span>
                        <span class="badge text-bg-secondary mt-1">Standard BDT</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Welcome Banner Card -->
        <div class="row">
            <div class="col-12">
                <div class="card card-primary card-outline shadow-sm mb-4">
                    <div class="card-header">
                        <h5 class="card-title fw-bold mb-0">
                            <i class="bi bi-wallet2 me-2 text-primary"></i>Daily Expense Tracker
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text text-muted fs-6">
                            Welcome to your personal Daily Expense Tracker built with <strong>.NET 10</strong>, <strong>Clean Architecture</strong>, <strong>MySQL</strong>, and <strong>AdminLTE 4</strong>.
                        </p>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            <a asp-page="/Expenses/Create" class="btn btn-primary px-4 fw-semibold">
                                <i class="bi bi-plus-lg me-1"></i> Entry Expense
                            </a>
                            <a asp-page="/Expenses/Index" class="btn btn-outline-secondary px-4 fw-semibold">
                                <i class="bi bi-table me-1"></i> View All Expenses
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
