<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Daily Expense Tracker</title>

    <!-- Google Fonts: Source Sans 3 -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- OverlayScrollbars -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.10.1/styles/overlayscrollbars.min.css" />

    <!-- AdminLTE 4 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/css/adminlte.min.css" />

    <!-- Custom overrides -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <div class="app-wrapper">

        <!-- Navbar / Header -->
        <nav class="app-header navbar navbar-expand bg-body shadow-sm">
            <div class="container-fluid">
                <!-- Left navbar links -->
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Toggle Navigation">
                            <i class="bi bi-list fs-4"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-page="/Index" class="nav-link fw-semibold">Dashboard</a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-page="/Expenses/Index" class="nav-link">Expenses</a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-page="/Expenses/Create" class="nav-link">Entry Expense</a>
                    </li>
                </ul>

                <!-- Right navbar links -->
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item me-2">
                        <a asp-page="/Expenses/Create" class="btn btn-primary btn-sm px-3 shadow-sm">
                            <i class="bi bi-plus-lg me-1"></i> New Expense
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                            <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
            <div class="sidebar-brand py-3 border-bottom border-secondary">
                <a asp-page="/Index" class="brand-link text-decoration-none d-flex align-items-center px-3">
                    <i class="bi bi-wallet2 fs-4 text-warning me-2"></i>
                    <span class="brand-text fw-bold text-light">ExpenseTracker</span>
                </a>
            </div>

            <div class="sidebar-wrapper">
                <nav class="mt-3">
                    <ul class="nav sidebar-menu flex-column" role="menu" data-accordion="false">
                        <li class="nav-header text-uppercase text-secondary small fw-bold px-3 mb-1">Overview</li>
                        <li class="nav-item">
                            <a asp-page="/Index" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")">
                                <i class="nav-icon bi bi-speedometer2 text-info"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        <li class="nav-header text-uppercase text-secondary small fw-bold px-3 mt-3 mb-1">Expenses</li>
                        <li class="nav-item">
                            <a asp-page="/Expenses/Index" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Expenses/Index" ? "active" : "")">
                                <i class="nav-icon bi bi-receipt text-success"></i>
                                <p>All Expenses</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-page="/Expenses/Create" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Expenses/Create" ? "active" : "")">
                                <i class="nav-icon bi bi-plus-circle text-primary"></i>
                                <p>Entry Expense</p>
                            </a>
                        </li>

                        <li class="nav-header text-uppercase text-secondary small fw-bold px-3 mt-3 mb-1">System</li>
                        <li class="nav-item">
                            <a asp-page="/Privacy" class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Privacy" ? "active" : "")">
                                <i class="nav-icon bi bi-shield-lock text-warning"></i>
                                <p>Privacy Policy</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="app-main">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="app-footer text-muted border-top py-3 px-4">
            <div class="float-end d-none d-sm-inline">
                <b>Currency</b> BDT (৳)
            </div>
            <strong>&copy; 2026 <a asp-page="/Index" class="text-decoration-none">Daily Expense Tracker</a>.</strong> Secure & Clean Architecture.
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.10.1/browser/overlayscrollbars.browser.es6.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-beta3/dist/js/adminlte.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
